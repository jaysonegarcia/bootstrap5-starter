{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1140px"
		},
		"color": {
			"palette": [
				{ "slug": "primary",   "color": "#0d6efd", "name": "Primary"   },
				{ "slug": "secondary", "color": "#6c757d", "name": "Secondary" },
				{ "slug": "success",   "color": "#198754", "name": "Success"   },
				{ "slug": "danger",    "color": "#dc3545", "name": "Danger"    },
				{ "slug": "warning",   "color": "#ffc107", "name": "Warning"   },
				{ "slug": "info",      "color": "#0dcaf0", "name": "Info"      },
				{ "slug": "light",     "color": "#f8f9fa", "name": "Light"     },
				{ "slug": "dark",      "color": "#212529", "name": "Dark"      },
				{ "slug": "white",     "color": "#ffffff", "name": "White"     },
				{ "slug": "black",     "color": "#000000", "name": "Black"     }
			],
			"gradients": [
				{
					"slug": "primary-to-info",
					"gradient": "linear-gradient(135deg, #0d6efd 0%, #0dcaf0 100%)",
					"name": "Primary to Info"
				}
			],
			"custom": true,
			"customGradient": true,
			"link": true
		},
		"typography": {
			"customFontSize": true,
			"dropCap": false,
			"fontSizes": [
				{ "slug": "small",   "size": "0.875rem", "name": "Small"   },
				{ "slug": "medium",  "size": "1rem",     "name": "Medium"  },
				{ "slug": "large",   "size": "1.25rem",  "name": "Large"   },
				{ "slug": "x-large", "size": "1.5rem",   "name": "Extra Large" },
				{ "slug": "xx-large","size": "2rem",     "name": "Huge"    }
			],
			"fontFamilies": [
				{
					"slug": "system",
					"name": "System Sans-Serif",
					"fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif"
				},
				{
					"slug": "serif",
					"name": "System Serif",
					"fontFamily": "Georgia, 'Times New Roman', Times, serif"
				},
				{
					"slug": "monospace",
					"name": "Monospace",
					"fontFamily": "SFMono-Regular, Menlo, Monaco, Consolas, 'Liberation Mono', 'Courier New', monospace"
				}
			]
		},
		"spacing": {
			"padding": true,
			"margin": true,
			"blockGap": true,
			"units": ["px", "em", "rem", "vh", "vw", "%"],
			"spacingScale": {
				"steps": 0
			},
			"spacingSizes": [
				{ "slug": "20", "size": "0.25rem", "name": "1" },
				{ "slug": "30", "size": "0.5rem",  "name": "2" },
				{ "slug": "40", "size": "1rem",    "name": "3" },
				{ "slug": "50", "size": "1.5rem",  "name": "4" },
				{ "slug": "60", "size": "3rem",    "name": "5" }
			]
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--dark)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--system)",
			"fontSize": "1rem",
			"lineHeight": "1.5"
		},
		"elements": {
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--info)"
					}
				}
			},
			"h1": { "typography": { "fontSize": "2.5rem", "fontWeight": "500", "lineHeight": "1.2" } },
			"h2": { "typography": { "fontSize": "2rem",   "fontWeight": "500", "lineHeight": "1.2" } },
			"h3": { "typography": { "fontSize": "1.75rem","fontWeight": "500", "lineHeight": "1.2" } },
			"h4": { "typography": { "fontSize": "1.5rem", "fontWeight": "500", "lineHeight": "1.2" } },
			"h5": { "typography": { "fontSize": "1.25rem","fontWeight": "500", "lineHeight": "1.2" } },
			"h6": { "typography": { "fontSize": "1rem",   "fontWeight": "500", "lineHeight": "1.2" } },
			"button": {
				"color": {
					"text":       "var(--wp--preset--color--white)",
					"background": "var(--wp--preset--color--primary)"
				},
				"border": { "radius": "0.375rem" },
				"spacing": { "padding": { "top": "0.5rem", "right": "1rem", "bottom": "0.5rem", "left": "1rem" } }
			}
		}
	}
}
